#!/usr/bin/env bash
# moar_dots - This is the main entrypoint for managing
# all dotfile and custom environment configuration.

# Entrypoint-only variables (must be set before sourcing lib)
export PROGRAM=$(basename "$0")
export COMMAND=$1
export LIBRARY_DIR="$(pwd)/lib"

# Load centralized variables and lib helpers (reqs.sh first so vars are available)
source "${LIBRARY_DIR}/reqs.sh"
for FILE in $(find "${LIBRARY_DIR}" -type f -name "*.sh" ! -name "reqs.sh"); do
	source "${FILE}"
done

# Display splash screen
splash

# Read command line arguements
case "${COMMAND}" in
    -b|--backup)
        backup
        ;;
    -i|--install)
        install
        ;;
    -r|--restore)
        restore "$2"
        ;;
    -u|--uninstall)
        uninstall
        ;;
    -h|--help)
        printusage
        ;;
    '')
        error "Please select a command. Please use -h or --help to see the available commands." >&2
        exit 1
        ;;
    *)
        error "Command not found. Please use -h or --help to see the available commands." >&2
        exit 1
        ;;
esac
