 {
    "reload_style_on_change": true,
    
    // Load bar at the top on the middle monitor.
    "layer": "top",
    "position": "top",
    "margin-top": 10,
   
   // Define the location of modulees.
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "temperature",
        "memory",
        "disk",
        "network",
        "pulseaudio"
    ],

    // Shorten the width of the overall bar and make slightly taller.
    "height": 35,
    "width": 2200,
    "spacing": "10",

    // Individual module configurations.
    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [ 1,2,3,4,5,6 ]
        },
        "workspace-taskbar": {
            "enable": false,
            "update-active-window": true,
            "format": "{icon} {title:.22}",
            "icon-size": 18,
        }
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "{volume}% {icon}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        }
    },

    "custom/notification": {
        "tooltip": false,
        "format": "",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },

    "clock": {
        "format": "{:%H:%M:%S - %A %m/%d/%Y} ",
        "format-alt": "{:L%d %B W%V %Y}",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "today": "<span color='#fAfBfC'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "shift_down",
            "on-click": "shift_up"
        }
    },

    "network": {
        "interface": "eno1",
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet":"{ipaddr}/{cidr} ",
        "format-disconnected": "",
        "tooltip-format-disconnected": "Error",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} 🖧 ",
    },

    "custom/colorpicker": {
        "format": "{}",
        "return-type": "json",
        "interval": "once",
        "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
        "on-click": "~/.config/waybar/scripts/colorpicker.sh",
        "signal": 1
    },

    "cpu": {
        "interval": 2,
        "format": "{icon} {usage}% ",
        "format-icons": [
            "<span color='#69ff94'>▁</span>", // green
            "<span color='#2aa9ff'>▂</span>", // blue
            "<span color='#f8f8f2'>▃</span>", // white
            "<span color='#f8f8f2'>▄</span>", // white
            "<span color='#ffffa5'>▅</span>", // yellow
            "<span color='#ffffa5'>▆</span>", // yellow
            "<span color='#ff9977'>▇</span>", // orange
            "<span color='#dd532e'>█</span>"  // red
        ],
        "tooltip": true
    },

    "disk": {
        "interval": 2,
        "format": "{percentage_used}% ",
        "path": "/",
        "unit": "GiB"
    },

    "memory": {
        "format": "{percentage}% ",
        "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} / {swapAvail:0.1f} GiB"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C ",
    },
}

